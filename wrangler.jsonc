{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  // `mcp.ekubo.org` is the only name this server is published under. The
  // default `mcp.<subdomain>.workers.dev` hostname was serving the same
  // Worker, and nothing that fronts the custom domain fronts it: an edge rule
  // is scoped to a zone, and `workers.dev` is Cloudflare's zone rather than
  // this account's, so no redirect rule can be written against it at all.
  //
  // This unroutes the Worker from that hostname rather than deleting it. The
  // account subdomain is a wildcard, so `mcp.<subdomain>.workers.dev` still
  // resolves and Cloudflare answers 404 at the edge — the same 404 a name that
  // was never a Worker gets. The point is that the request stops reaching this
  // Worker, not that the DNS name disappears.
  //
  // `preview_urls` below defaults to this value, which is why it is stated
  // separately rather than left to follow.
  "workers_dev": false,
  // Per-version preview URLs are off deliberately: this Worker is a public
  // unauthenticated endpoint fronted by an edge rule, and a preview URL is the
  // same server without it. Declared here rather than left to the dashboard,
  // because a deploy resets an undeclared setting to wrangler's default of on.
  // The same is true of `workers_dev` above, which is why it is now stated
  // rather than omitted.
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {
    "required": [
      "ZERO_X_API_KEY",
      "ACROSS_API_KEY",
      "ACROSS_INTEGRATOR_ID",
      "LAYER_ZERO_API_KEY",
      "LI_FI_API_KEY",
      "DUNE_API_KEY"
    ]
  },
  "vars": {
    "EKUBO_API_URL": "https://prod-api.ekubo.org",
    "EKUBO_QUOTER_URL": "https://prod-api-quoter.ekubo.org",
    // The integration LI.FI registers this server's volume under. Not a
    // credential — it travels in the query string of every quote and comes
    // back in the source_url a caller is shown — so it belongs in version
    // control beside the URLs rather than in the secret store. Declared here
    // rather than set in the dashboard because a variable added there lands
    // on a new version that a deploy does not necessarily promote, so the
    // running code can silently keep quoting without it.
    "LI_FI_INTEGRATOR": "ekubo-wallet"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACT_STORE",
      "bucket_name": "mcp-artifacts"
    }
  ],
  // Per-caller budgets. The endpoint is unauthenticated, so the caller is an
  // IPv4 address or an IPv6 /64, and these numbers are the whole of what one
  // of them may spend. See src/rate-limit.ts for what each budget bounds and
  // README.md for the edge rule that sits in front of them.
  //
  // Namespace IDs are arbitrary and only have to stay unique and stable within
  // this Worker: changing one resets its counters.
  "ratelimits": [
    {
      "name": "RATE_LIMITER_BURST",
      "namespace_id": "1001",
      // A flood is visible within ten seconds instead of after a minute of it.
      // Sized above any legitimate client's start-up burst, which is now seven
      // sessions rather than one: a harness configured with the per-protocol
      // endpoints opens `ekubo` plus one server per satellite protocol, and
      // each of those opens with a stream GET, initialize,
      // notifications/initialized, tools/list, resources/list, and
      // prompts/list back to back — around forty requests from one caller
      // inside a couple of seconds, against a ceiling of thirty. The wallet
      // writes all seven by default and brings already-connected agents up to
      // that set on its next launch, so the first harness start after an
      // update was the case that overran this.
      //
      // Raising it costs no upstream spend. Every request in that burst is
      // local work — a catalog the Worker already holds — and prices at zero
      // tool units, so RATE_LIMITER_TOOLS and RATE_LIMITER_METERED below are
      // untouched and still bound everything that reaches a third party.
      // These two budgets bound request volume, which is the cheap axis.
      "simple": { "limit": 120, "period": 10 }
    },
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      // Sustained requests across every route, tool calls included. Scaled
      // with the burst above for the same reason: two harness restarts inside
      // a minute is ordinary and already cost eighty-four requests before a
      // single tool was called.
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_TOOLS",
      "namespace_id": "1003",
      // Weighted tool cost, where 1 unit is one ordinary prod-api read. At 120
      // a caller gets roughly ten full swap flows a minute, or a hundred
      // catalog reads, and a catalog scrape stalls within seconds.
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_METERED",
      "namespace_id": "1004",
      // Calls that spend 0x, Across, or Dune credit. Small and separate on
      // purpose: this is the budget that maps to an invoice, and no amount of
      // cheap traffic should be able to buy headroom in it.
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
