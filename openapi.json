{
  "openapi": "3.1.0",
  "info": {
    "title": "Ekubo Protocol MCP Gateway",
    "version": "0.41.0",
    "description": "Discovery contract for the public, unauthenticated, non-custodial Ekubo MCP server. It exposes interface-equivalent Ekubo tools plus fixed local Aave, Morpho, Sky, and Lido catalogs with signer-neutral transaction preparation. Agents query official public APIs and the user's wallet/RPC directly; Uniswap tools additionally fetch indexed pool discovery and chart data from the official interface GraphQL API. Reusable protocol skills describe those direct workflows. MCP clients discover typed tool schemas through tools/list; GET /tools provides the same revisioned catalog to ordinary HTTP clients.",
    "contact": {
      "url": "https://ekubo.org",
      "email": "eng@ekubo.org"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current deployment origin"
    }
  ],
  "externalDocs": {
    "url": "https://modelcontextprotocol.io/specification/2025-11-25/basic/transports",
    "description": "MCP Streamable HTTP transport"
  },
  "security": [],
  "paths": {
    "/": {
      "get": {
        "operationId": "getServiceMetadata",
        "summary": "Discover the Ekubo MCP service",
        "responses": {
          "200": {
            "description": "MCP endpoint, documentation URLs, upstream contracts, and safety boundaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/tools": {
      "get": {
        "operationId": "listPublicTools",
        "summary": "List MCP tools without an MCP client",
        "description": "MCP clients should use tools/list at /mcp, or at /mcp/{protocol} for one protocol's tools. This uncached endpoint makes the deterministic, revisioned tool catalog visible to crawlers and ordinary HTTP clients.",
        "responses": {
          "200": {
            "description": "Tool names, descriptions, and JSON input schemas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "server_version",
                    "catalog_revision",
                    "tool_count",
                    "tools"
                  ],
                  "properties": {
                    "server_version": {
                      "type": "string"
                    },
                    "catalog_revision": {
                      "type": "string"
                    },
                    "tool_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tools": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tool"
                      }
                    },
                    "mcp_endpoint": {
                      "type": "string",
                      "description": "The endpoint that serves exactly the returned tools."
                    },
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "ekubo",
                        "aave",
                        "aerodrome",
                        "lido",
                        "merkl",
                        "morpho",
                        "sky",
                        "uniswap"
                      ],
                      "description": "Present only when the catalog was filtered."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "parameters": [
          {
            "name": "protocol",
            "in": "query",
            "required": false,
            "description": "Return only the tools served by /mcp/{protocol}. Omit for the whole catalog. An unknown value is a 404 rather than a silent full catalog.",
            "schema": {
              "type": "string",
              "enum": [
                "ekubo",
                "aave",
                "aerodrome",
                "lido",
                "merkl",
                "morpho",
                "sky",
                "uniswap"
              ]
            }
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "summary": "Fetch this OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/skills/use-morpho/SKILL.md": {
      "get": {
        "operationId": "getMorphoSkill",
        "summary": "Fetch the direct-discovery Morpho agent skill",
        "responses": {
          "200": {
            "description": "Markdown skill instructions",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/skills/use-sky/SKILL.md": {
      "get": {
        "operationId": "getSkySkill",
        "summary": "Fetch the direct-discovery Sky agent skill",
        "responses": {
          "200": {
            "description": "Markdown skill instructions",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/skills/use-lido/SKILL.md": {
      "get": {
        "operationId": "getLidoSkill",
        "summary": "Fetch the direct-discovery Lido agent skill",
        "responses": {
          "200": {
            "description": "Markdown skill instructions",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/mcp": {
      "get": {
        "operationId": "openMcpStream",
        "summary": "Open the MCP Streamable HTTP receive channel",
        "responses": {
          "200": {
            "description": "MCP response or server-sent event stream"
          },
          "405": {
            "description": "No stream is available for the request"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "operationId": "sendMcpMessage",
        "summary": "Send an MCP JSON-RPC message",
        "description": "Use initialize and tools/list for protocol-native discovery, then tools/call to invoke an Ekubo read or unsigned-preparation tool. The server never signs or submits transactions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "202": {
            "description": "MCP notification accepted"
          },
          "400": {
            "description": "Invalid MCP request, more than 20 JSON-RPC messages in one request, or tool calls whose combined cost exceeds the 40-unit per-request ceiling"
          },
          "413": {
            "description": "Request body larger than 262144 bytes",
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/mcp/{protocol}": {
      "get": {
        "operationId": "openProtocolMcpStream",
        "summary": "Open the MCP Streamable HTTP receive channel for one protocol",
        "responses": {
          "200": {
            "description": "MCP response or server-sent event stream"
          },
          "405": {
            "description": "No stream is available for the request"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "operationId": "sendProtocolMcpMessage",
        "summary": "Send an MCP JSON-RPC message to one protocol's server",
        "description": "The same MCP contract as /mcp, narrowed to one protocol. Use it to give an agent a single protocol's tools instead of the whole catalog. /mcp remains available and unchanged.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "202": {
            "description": "MCP notification accepted"
          },
          "400": {
            "description": "Invalid MCP request, more than 20 JSON-RPC messages in one request, or tool calls whose combined cost exceeds the 40-unit per-request ceiling"
          },
          "413": {
            "description": "Request body larger than 262144 bytes",
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "parameters": [
        {
          "name": "protocol",
          "in": "path",
          "required": true,
          "description": "The protocol this endpoint serves. Each endpoint registers exactly that protocol's tools and its own skill resources; the tool names and schemas are identical to the ones /mcp serves.",
          "schema": {
            "type": "string",
            "enum": [
              "ekubo",
              "aave",
              "aerodrome",
              "lido",
              "merkl",
              "morpho",
              "sky",
              "uniswap"
            ]
          }
        }
      ]
    }
  },
  "components": {
    "responses": {
      "RateLimited": {
        "description": "Per-caller rate limit exceeded. Limits apply per IPv4 address or IPv6 /64 over four budgets: requests per few seconds, requests per minute, weighted tool cost per minute, and calls per minute to tools that buy quotes or recommendations from a third party. Honor Retry-After rather than retrying on a fixed interval.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "$ref": "#/components/schemas/JsonRpcRateLimitError"
                }
              ]
            }
          }
        }
      },
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "JsonRpcRateLimitError": {
        "description": "Returned when the rejected request was a single identified JSON-RPC call, so the client can attach the refusal to that call.",
        "type": "object",
        "required": [
          "jsonrpc",
          "id",
          "error"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "data"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "const": -32029
              },
              "message": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "required": [
                  "reason",
                  "scope",
                  "retry_after_seconds"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "const": "rate_limited"
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "burst",
                      "sustained",
                      "tool_units",
                      "metered_providers"
                    ]
                  },
                  "retry_after_seconds": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "name",
          "title",
          "description",
          "inputSchema"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          },
          "annotations": {
            "type": "object",
            "additionalProperties": true
          },
          "outputSchema": {
            "type": "object"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "ekubo",
              "aave",
              "aerodrome",
              "lido",
              "merkl",
              "morpho",
              "sky",
              "uniswap"
            ],
            "description": "The /mcp/<slug> endpoint that serves this tool. /mcp serves every tool."
          }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "const": "2.0"
          },
          "id": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "method": {
            "type": "string",
            "examples": [
              "initialize",
              "tools/list",
              "tools/call"
            ]
          },
          "params": {}
        }
      }
    }
  }
}
